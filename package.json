{
  "name": "chat",
  "version": "1.0.0",
  "description": "A production-ready, highly scalable, and secure real-time chat application backend specifically engineered for developer communities. This backend forms the core of a MERN-stack architecture, utilizing Node.js, Express, Socket.io, and MongoDB (Mongoose) to deliver robust communication streams, sandboxed code execution, and high-performance data handling.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "node --env-file=.env scripts/seed.js",
    "verify:models": "node --env-file=.env scripts/verify-models.js",
    "verify:socket": "node --env-file=.env scripts/verify-socket.js",
    "verify:re": "node --env-file=.env scripts/verify-re.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasmarga50-png/Chat_Applications.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/eliasmarga50-png/Chat_Applications/issues"
  },
  "homepage": "https://github.com/eliasmarga50-png/Chat_Applications#readme",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
